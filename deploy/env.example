# Copy this file to /etc/jmbot.env on the server and edit the values.

JM_BOT_HOST=127.0.0.1
JM_BOT_PORT=8080
JM_BOT_COMMAND_PREFIX=/jm
# all keeps the current process; run two instances with download/chat after
# the MaiBot OneBot adapter and ingress filtering have passed P0 verification.
JM_BOT_SERVICE_ROLE=all
JM_BOT_CHAT_BACKEND=nonebot
JM_BOT_CONVERSATION_DB=data/conversation.sqlite3
JM_BOT_ADMIN_DB=data/admin.sqlite3
JM_BOT_ADMIN_PORT=8081
JM_BOT_CHAT_SCHEDULER_WORKERS=2
JM_BOT_CHAT_SCHEDULER_SCOPE_LIMIT=8

# Process one album at a time by default. Raise only if your server has enough CPU/RAM.
JM_BOT_MAX_CONCURRENCY=1

# jmcomic internal download concurrency for general servers.
JM_BOT_DOWNLOAD_IMAGE_THREADS=10
JM_BOT_DOWNLOAD_PHOTO_THREADS=2
JM_BOT_JMCOMIC_LOG=true
JM_BOT_JMCOMIC_RETRY_TIMES=5
JM_BOT_JOB_TIMEOUT_SECONDS=1800
JM_BOT_AUTO_SPLIT_PDF=true
JM_BOT_SPLIT_IMAGE_COUNT=80

# Metadata queries run in isolated child processes.
JM_BOT_QUERY_TIMEOUT_SECONDS=20
JM_BOT_QUERY_MAX_CONCURRENCY=1
JM_BOT_DETAIL_CACHE_TTL_SECONDS=300
JM_BOT_QUERY_CACHE_MAX_ENTRIES=128
JM_BOT_PREVIEW_ROOT=data/preview
JM_BOT_PREVIEW_PAGE_COUNT=10
JM_BOT_PREVIEW_TIMEOUT_SECONDS=180
JM_BOT_DEFAULT_FORMAT=pdf
JM_BOT_ALLOWED_FORMATS=pdf,zip
JM_BOT_PROGRESS_MODE=precise
JM_BOT_HISTORY_RETENTION_DAYS=7
JM_BOT_HISTORY_MAX_PER_USER=50

# Leave empty to allow all groups, or use comma-separated QQ group IDs.
JM_BOT_ALLOWED_GROUPS=123456789,987654321

# Comma-separated QQ user IDs with JM admin permission.
# These users can clear pending jobs, cancel active jobs, and move jobs to the front.
JM_BOT_SUPERUSERS=123456789

JM_BOT_DOWNLOAD_ROOT=data/downloads
JM_BOT_OUTPUT_ROOT=data/output
JM_BOT_OPTION_ROOT=data/options
JM_BOT_QUEUE_DB=data/queue.sqlite3
JM_BOT_USER_DB=data/user.sqlite3
JM_BOT_CHAT_DB=data/chat.sqlite3
JM_BOT_CHAT_ROLE=data/chat_role.json
JM_BOT_CHAT_MASTER_KEY_PATH=/etc/jmbot/chat-master.key
JM_BOT_CLEAN_AFTER_UPLOAD=true
JM_BOT_GROUP_FOLDER=JM

# Chat settings. The default school credential is supplied only through the
# server secret environment; never commit it or print it in logs.
JM_BOT_CHAT_DEFAULT_PROVIDER=ds_school
JM_BOT_CHAT_DEFAULT_API_KEY=
JM_BOT_CHAT_ENDPOINT=https://api.deepseek.com/chat/completions
JM_BOT_CHAT_DS_ENDPOINT=https://api.deepseek.com/chat/completions
JM_BOT_CHAT_GLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
JM_BOT_CHAT_KIMI_ENDPOINT=https://api.moonshot.cn/v1/chat/completions
JM_BOT_CHAT_QWEN_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# Optional model overrides. Defaults: deepseek-chat, glm-4-flash,
# moonshot-v1-8k, qwen-turbo. The school gateway uses JM_BOT_CHAT_MODEL.
JM_BOT_CHAT_DS_MODEL=deepseek-chat
JM_BOT_CHAT_GLM_MODEL=glm-4-flash
JM_BOT_CHAT_KIMI_MODEL=moonshot-v1-8k
JM_BOT_CHAT_QWEN_MODEL=qwen-turbo
# Optional HTTP proxy used only for chat API calls, e.g. http://127.0.0.1:8080.
JM_BOT_CHAT_PROXY=
JM_BOT_CHAT_MODEL=deepseek-flash
JM_BOT_CHAT_TIMEOUT_SECONDS=60
JM_BOT_GROUP_CHAT_HISTORY_LIMIT=12
JM_BOT_GROUP_CHAT_CONTEXT_SECONDS=600
JM_BOT_GROUP_CHAT_ACTIVE_SECONDS=180
JM_BOT_GROUP_CHAT_FOLLOWUP_COOLDOWN_SECONDS=3
JM_BOT_GROUP_CHAT_OBSERVE_ENABLED=true
JM_BOT_GROUP_CHAT_OBSERVE_MIN_SECONDS=60
JM_BOT_GROUP_CHAT_OBSERVE_MAX_SECONDS=60
JM_BOT_GROUP_CHAT_REPLY_COOLDOWN_SECONDS=45
JM_BOT_GROUP_CHAT_PROACTIVE_LIMIT=3
JM_BOT_CHAT_REPLY_MAX_LENGTH=500
JM_BOT_CHAT_ALIASES=大肥鱼,大肥鱼喵,吃白饭大肥鱼,JM大使
