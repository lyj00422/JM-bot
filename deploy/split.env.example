# Copy to /etc/jmbot-split.env; chmod 600. One configured QQ account per stack.
JM_BOT_HOST=127.0.0.1
JM_BOT_PORT=8080
JM_BOT_SERVICE_ROLE=download
JM_BOT_CHAT_BACKEND=maibot
JM_BOT_QQ_ACCOUNT=REPLACE_WITH_BOT_QQ
JM_BOT_SERVICE_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JM_BOT_DOWNLOAD_SERVICE_URL=http://127.0.0.1:8080
JM_BOT_ADMIN_SERVICE_URL=http://127.0.0.1:8081
JM_BOT_CHAT_SERVICE_URL=http://127.0.0.1:8082
JM_BOT_CHAT_PORT=8082
JM_BOT_ADMIN_PORT=8081
JM_BOT_QUEUE_DB=/opt/jmbot/data/queue.sqlite3
JM_BOT_USER_DB=/opt/jmbot/data/user.sqlite3
JM_BOT_DOWNLOAD_POLICY_DB=/opt/jmbot/data/download-policy.sqlite3
JM_BOT_ADMIN_DB=/opt/jmbot/data/admin.sqlite3
JM_BOT_CONVERSATION_DB=/opt/jmbot/data/conversation.sqlite3
JM_BOT_CHAT_DB=/opt/jmbot/data/chat.sqlite3
JM_BOT_CHAT_MASTER_KEY_PATH=/etc/jmbot/chat-master.key
JM_BOT_CHAT_ROLE=/opt/jmbot/data/chat_role.json
JM_BOT_STICKER_DIR=/opt/jmbot/data/stickers
JM_BOT_CHAT_DATA=/opt/jmbot/data/chat-service
JM_BOT_RELEASE_VERSION=0.3.22
JM_BOT_MODEL_ROUTES=/opt/jmbot/config/model-routes.json
JM_BOT_MAIBOT_SOURCE=/opt/MaiBot
JM_BOT_MAIBOT_PYTHON=/opt/MaiBot/.venv/bin/python
# Set to the source commit only AFTER reading upstream EULA.md and PRIVACY.md.
JM_BOT_MAIBOT_TERMS_ACCEPTED=
# One native process per account; foreground/background queues use 2/1 workers.
# Runtime count is fixed in NativePool; session limits remain configurable.
JM_BOT_NATIVE_SESSION_LIMIT=8
JM_BOT_NATIVE_SESSION_IDLE_SECONDS=300
JM_BOT_NATIVE_WEBUI_PORT=8001
JM_BOT_PREWARM_NATIVE=1
# Keep prompt capture disabled in production; enable only in an isolated P0 probe.
JM_BOT_CAPTURE_PROMPTS=0
JM_BOT_OFFICIAL_CONNECTOR_ENABLED=0
JM_BOT_EMOJI_MODE=selector
JM_BOT_EMOJI_COLLECTION_LIMIT=256
# Automatic emoji collection size; QQ media ingress currently caps files at 8 MiB.
JM_BOT_EMOJI_MAX_SIZE_MB=8
# Poll cached emoji files every minute so a scope does not wait through rotation.
JM_BOT_EMOJI_CHECK_INTERVAL_MINUTES=1
JM_BOT_CHAT_DEFAULT_PROVIDER=ds_school
JM_BOT_CHAT_DEFAULT_API_KEY=
# Private task-specific provider keys stay in /etc/jmbot-split.env.
JM_BOT_MODEL_KEY_SILICONFLOW=
# Optional forward proxy for outbound model calls (e.g. school iWAN gateway).
JM_BOT_CHAT_PROXY=
JM_BOT_MAX_CONCURRENCY=1
JM_BOT_SUPERUSERS=3065532050
JM_BOT_NAPCAT_MEDIA_ROOT=/opt/napcat
# Docker bind mount used by get_image; omit both for a host-native NapCat.
JM_BOT_NAPCAT_MEDIA_CONTAINER_ROOT=/app/.config/QQ
JM_BOT_NAPCAT_MEDIA_HOST_ROOT=/opt/napcat/ntqq
JM_BOT_NAPCAT_WEBUI_URL=http://127.0.0.1:6099
JM_BOT_NAPCAT_WEBUI_TOKEN=
# All legacy and split senders/migration commands must share this directory.
JM_BOT_RUNTIME_LOCK_DIR=/opt/jmbot/data
