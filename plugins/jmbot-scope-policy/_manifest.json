{
  "manifest_version": 2,
  "id": "jmbot.scope-policy",
  "version": "0.1.0",
  "name": "JMbot 会话作用域策略",
  "description": "在 MaiBot 正式插件边界执行 JMbot 会话开关、人设注入和发送前拒绝。",
  "author": {"name": "JMbot", "url": "https://github.com/lyj00422/JM-bot"},
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/lyj00422/JM-bot",
    "homepage": "https://github.com/lyj00422/JM-bot",
    "documentation": "https://github.com/lyj00422/JM-bot/tree/codex/maibot-native-single-runtime/plugins/jmbot-scope-policy",
    "issues": "https://github.com/lyj00422/JM-bot/issues"
  },
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]},
  "plugin_type": "functional",
  "host_application": {"min_version": "1.3.0", "max_version": "1.3.99"},
  "sdk": {"min_version": "2.5.0", "max_version": "2.99.99"},
  "capabilities": ["chat.receive.before_process", "send_service.before_send", "maisaka.planner.before_request", "maisaka.replyer.before_model_request"]
}
