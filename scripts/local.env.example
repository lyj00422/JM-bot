# Copy this file to scripts/local.env and edit private local values.
# scripts/local.env is ignored by git.

JM_BOT_HOST=127.0.0.1
JM_BOT_PORT=8080
JM_BOT_COMMAND_PREFIX=/jm

# Leave empty to allow all groups, or use comma-separated QQ group IDs.
JM_BOT_ALLOWED_GROUPS=

# Comma-separated QQ user IDs with superuser permission.
JM_BOT_SUPERUSERS=

JM_BOT_DOWNLOAD_ROOT=data/downloads
JM_BOT_OUTPUT_ROOT=data/output
JM_BOT_OPTION_ROOT=data/options
JM_BOT_QUEUE_DB=data/queue.sqlite3
JM_BOT_CLEAN_AFTER_UPLOAD=true
JM_BOT_GROUP_FOLDER=JM

# Generic local defaults. Increase only if your machine has enough CPU and memory.
JM_BOT_MAX_CONCURRENCY=1
JM_BOT_DOWNLOAD_IMAGE_THREADS=10
JM_BOT_DOWNLOAD_PHOTO_THREADS=2
JM_BOT_JMCOMIC_LOG=true
JM_BOT_JMCOMIC_RETRY_TIMES=5

# NapCat one-click launcher settings for scripts/start_all.ps1.
# Set either JM_BOT_NAPCAT_SCRIPT or JM_BOT_NAPCAT_DIR.
JM_BOT_NAPCAT_SCRIPT=
JM_BOT_NAPCAT_DIR=

# Optional: enables the launcher to query NapCat WebUI status.
JM_BOT_NAPCAT_WEBUI_CONFIG=
